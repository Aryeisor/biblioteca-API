PORT=3000

# Número de proxies TUYOS delante de la app (Nginx, balanceador...).
# 0 = sin proxy (desarrollo local). 1 = detrás de un Nginx/balanceador.
# Nunca pongas más de los que controlas: el cliente podría falsificar su IP con X-Forwarded-For.
TRUST_PROXY=0

# Orígenes (frontends) que pueden llamar a la API desde el navegador, separados por comas.
# Vacío = ninguno (lo más seguro). Ej: http://localhost:5173,https://mi-front.com
CORS_ORIGINS=

# Nivel de logs: fatal, error, warn, info (por defecto), debug, trace o silent
LOG_LEVEL=info

# Redis para los contadores del rate limiting (opcional).
# Sin esta variable se usa la memoria del proceso: sirve con UNA sola instancia.
# Con `docker compose up -d redis` queda en este puerto.
# REDIS_URL=redis://localhost:6379

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=tu_contraseña
DB_NAME=biblioteca

JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=1h
